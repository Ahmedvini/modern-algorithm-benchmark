+
+std::vector<mab::ConfiguredSorter> selected_sorters(std::string_view names, int threads) {
+    if (names == "all") names="merge_sort,parallel_merge_sort";
+    std::vector<mab::ConfiguredSorter> selected;
+    while (true) {
+        const auto comma = names.find(',');
+        const auto sorter = mab::find_parallel_sorter(names.substr(0, comma),threads);
+        for (const auto& prior : selected)
+            if (prior.name == sorter.name) throw std::invalid_argument("duplicate sorter");
+        selected.push_back(sorter);
+        if (comma == std::string_view::npos) break;
+        names.remove_prefix(comma + 1);
+    }
+    return selected;
+}
