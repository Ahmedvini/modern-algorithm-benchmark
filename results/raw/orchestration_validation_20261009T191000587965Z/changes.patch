+                    conversion=scale,points=points,dataset_groups=sorted(set(ids)),outputs={fmt:name+'.'+fmt for fmt in ['svg','pdf']}))
+        fig,ax=plt.subplots(figsize=(7.2,4.6));labels=[];values=[]
